# 공통 API 클라이언트가 사용하는 배포 서버 Origin.
VITE_API_BASE_URL=https://api.meetdle.co.kr

# 백엔드에서 제공하는 카카오 OAuth 로그인 시작 URL (절대 URL).
# 실제 주소는 .env.local에 설정하고 개발 서버를 재시작합니다.
# Client Secret이나 토큰을 VITE_ 환경변수에 넣지 않습니다.
VITE_KAKAO_LOGIN_URL=

# Kakao Maps Web SDK JavaScript 키. 카카오맵 사용 ON 및 SDK 도메인 등록 필요.
VITE_KAKAO_MAP_APP_KEY=
